# --- App ---
PROJECT_NAME=SIH26105 Cyber Risk Platform
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change_this_to_a_long_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+psycopg2://sih_admin:sih_password@localhost:5432/sih_cyber_risk

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Seed admin user (Phase 1 demo login) ---
SEED_ADMIN_EMAIL=admin@sih2026.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ORG_NAME=Demo Financial Services Ltd
